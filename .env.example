# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Client key: legacy anon JWT or new publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server key: legacy service_role JWT or new secret key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Optional — not required by the app today
# SUPABASE_JWKS_URL=

# App
# In production this MUST be the real public HTTPS URL — it's baked into
# every generated Apple pass as `webServiceURL` (Apple's servers call back
# into it) and used to build Google Wallet asset URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enable Google / Apple in Supabase Auth providers,
# then add the redirect URL: {NEXT_PUBLIC_APP_URL}/auth/callback

# Stripe billing — test mode during development (test keys are prefixed
# sk_test_/pk_test_/whsec_...; swap the whole block for live keys/prices
# when going live). Checkout is entirely server-side (hosted Checkout
# Session, see app/api/billing/checkout) — no publishable key is needed by
# this app, since no client-side Stripe.js/Elements is loaded anywhere.
# Server-side secret key from Stripe Dashboard > Developers > API keys.
# NEVER expose this to the client.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (Developers > Webhooks > your
# endpoint > Signing secret), prefixed whsec_. When testing locally with
# `stripe listen`, use the whsec_ value that command prints instead.
STRIPE_WEBHOOK_SECRET=
# Price IDs — see scripts/seed-stripe-catalog.ts, which creates these.
# Test mode and live mode catalogs are entirely separate.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_QUARTERLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_QUARTERLY=
STRIPE_PRICE_PRO_YEARLY=

# Apple Wallet
# Pass Type ID, e.g. pass.com.stampwallet.loyalty (Certificates, IDs & Profiles)
APPLE_PASS_TYPE_IDENTIFIER=
# Your 10-character Apple Developer Team ID
APPLE_TEAM_IDENTIFIER=
# Base64 of the Pass Type ID .p12 export (Keychain Access: export the cert
# + private key together as .p12, then: base64 -w0 cert.p12  — on macOS use
# `base64 -i cert.p12` instead of -w0)
APPLE_PASS_CERTIFICATE=
# The password you set when exporting the .p12 (empty string is fine if none)
APPLE_PASS_CERTIFICATE_PASSWORD=
# Apple WWDR intermediate certificate (download from Apple PKI, "G4" is
# current as of 2025). Either raw PEM text or base64 of it both work —
# base64 -w0 AppleWWDRCAG4.pem
APPLE_WWDR_CERTIFICATE=

# Google Wallet
# From the Google Wallet Console (Business account → Issuer ID)
GOOGLE_WALLET_ISSUER_ID=
# The full JSON key file for a service account with Wallet Object Issuer
# permission, either pasted raw or base64-encoded (base64 avoids env var
# systems mangling the embedded newlines in private_key):
# base64 -w0 service-account-key.json
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=

# Notifications cron (see vercel.json) — any random secret string; Vercel
# Cron sends it back as `Authorization: Bearer <value>`. Without this set,
# /api/cron/notifications and /api/cron/email-engagement refuse every request.
CRON_SECRET=

# Resend (email) — see lib/email/. NEVER expose RESEND_API_KEY to the client;
# every send happens server-side via lib/email/send.ts.
# API key from Resend Dashboard > API Keys.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend (Domains tab).
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=WalletOS
# Signing secret for Resend's own delivery webhook (Dashboard > Webhooks >
# your endpoint > Signing secret), used by app/api/webhooks/resend for
# delivered/bounced/complained observability. Optional — the app works
# without it, email_events just won't get delivery-status updates.
RESEND_WEBHOOK_SECRET=
# Signing secret for Supabase Auth's "Send Email" hook (Dashboard >
# Authentication > Hooks), used by app/api/auth/email-hook to send branded
# verification/password-reset/invite emails instead of Supabase's default
# ones. Comes prefixed `v1,whsec_...` — paste it exactly as Supabase shows
# it, the prefix is stripped automatically.
SUPABASE_AUTH_HOOK_SECRET=
# Non-production safety valve — with this UNSET, no environment other than
# production sends real email (dev/preview log "would have sent" instead).
# Set to your own inbox to actually receive test sends locally; every email
# gets redirected there regardless of its real recipient.
RESEND_DEV_MODE_TO=
